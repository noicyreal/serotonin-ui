-- Run as a LocalScript beside the installed ReplicatedStorage.Serotonin module.
local Serotonin = require(game:GetService("ReplicatedStorage"):WaitForChild("Serotonin"))
local HttpService = game:GetService("HttpService")
local passed = {}
local window = Serotonin.new({Name = "SerotoninSmokeTest", Preview = false})
window:SetVisible(false)
local function check(name, condition)
    assert(condition, "FAILED: " .. name)
    table.insert(passed, name)
end
local ok, problem = xpcall(function()
    local tab = window:AddTab("One")
    local tab2 = window:AddTab("Two")
    local section = tab:AddSection({Title = "Inputs"})
    local snapshot
    local toggle = section:AddToggle({Text = "Enabled", Flag = "Enabled", Default = false,
        Callback = function() snapshot = window.Flags.Choice end,
    })
    local integer = section:AddSlider({Text = "Whole numbers", Flag = "Integer", Min = 0, Max = 100, Step = 1, Default = 7})
    check("integer slider formats zero decimal places", integer.Instance.Value.Text == "7")
    local fraction = section:AddSlider({Text = "Fraction", Flag = "Fraction", Min = -2, Max = 2, Step = 0.25, Default = 0})
    fraction:SetValue(1.27)
    check("fractional slider quantizes from its minimum", fraction:GetValue() == 1.25)
    fraction:SetValue(100)
    check("slider clamps to maximum", fraction:GetValue() == 2)
    check("NaN is rejected", not pcall(function() fraction:SetValue(0 / 0) end))
    local dropdown = section:AddDropdown({Text = "Choice", Flag = "Choice", Options = {"One", "Two"}})
    local color = section:AddColorPicker({Text = "Color", Flag = "Color", Default = {Color = Color3.fromRGB(23, 140, 201), Transparency = 0.3}})
    local key = section:AddKeybind({Text = "Key", Flag = "Key", Default = Enum.KeyCode.F})
    local textbox = section:AddTextbox({Text = "Text", Flag = "Text", Default = "line one\nline two"})
    toggle:SetValue(true)
    dropdown:SetValue("Two")
    local saved = window:ExportConfig()
    window:ResetConfig()
    check("reset restores defaults", not toggle:GetValue() and dropdown:GetValue() == "One" and fraction:GetValue() == 0)
    check("configuration imports", window:ImportConfig(saved))
    check("configuration preserves booleans and dropdowns", toggle:GetValue() and dropdown:GetValue() == "Two")
    check("callbacks observe the entire imported configuration", snapshot == "Two")
    check("configuration preserves colors and transparency", math.abs(color:GetValue().Color.G - 140 / 255) < 0.00001 and color:GetValue().Transparency == 0.3)
    check("configuration preserves text and keys", textbox:GetValue() == "line one\nline two" and key:GetValue() == Enum.KeyCode.F)
    local rejected = window:ImportConfig(HttpService:JSONEncode({Version = 1, Values = {Enabled = false, Choice = "Missing"}}))
    check("invalid import is atomic", not rejected and toggle:GetValue() and dropdown:GetValue() == "Two")
    local badColor = window:ImportConfig(HttpService:JSONEncode({Version = 1, Values = {Color = {Color = {2, 0, 0}, Transparency = 0}}}))
    check("out-of-range color is rejected", not badColor)
    check("malformed JSON is rejected", not window:ImportConfig("{broken"))
    check("unknown flags are tolerated", window:ImportConfig(HttpService:JSONEncode({Version = 1, Values = {FutureSetting = 4}})))
    check("duplicate flags are rejected", not pcall(function() section:AddToggle({Text = "Duplicate", Flag = "Enabled"}) end))
    window:SelectTab("Two")
    check("tab selection has one visible page", tab2.Page.Visible and not tab.Page.Visible and window.ActiveTab == "Two")
    window:SetScale(0.5)
    check("scale applies", window.Scale.Scale == 0.5)
    window:SetScale(1.5)
    check("scale stays inside the viewport", window.Scale.Scale <= 1.5 and window.Root.AbsolutePosition.X >= 0)
    window:SetAccent(Color3.fromRGB(200, 90, 180))
    check("accent updates existing controls", toggle.Button.Box.Fill.BackgroundColor3 == window.Theme.Accent)
    local connections = table.clone(window._connections)
    window:Destroy()
    check("destroy removes the GUI", window.Gui.Parent == nil)
    local disconnected = true
    for _, connection in ipairs(connections) do if connection.Connected then disconnected = false end end
    check("destroy disconnects all registered signals", disconnected and #window._connections == 0)
    window:Destroy()
    check("destroy is idempotent", true)
    local external = Serotonin.new({Name = "SerotoninExternalDestroyTest", Preview = false})
    external.Gui:Destroy()
    task.wait()
    check("external GUI destruction cleans up connections", external._destroyed and #external._connections == 0)
end, debug.traceback)
window:Destroy()
if not ok then error(problem) end
print("[Serotonin] " .. #passed .. " smoke checks passed")
return {Passed = #passed, Checks = passed}
